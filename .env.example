# Firebase Web configuration (safe to expose to the browser, but keep deployment configuration out of source).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin service-account credentials. Keep this protected and never commit it.
# Prefer the single JSON variable in local/deployed environment configuration.
FIREBASE_ADMIN_CREDENTIALS_JSON=
# Or point to a protected local service-account file:
# FIREBASE_ADMIN_CREDENTIALS_FILE=/absolute/path/to/firebase-adminsdk.json
# Or provide these protected variables instead of the JSON blob:
# FIREBASE_ADMIN_TYPE=service_account
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_TOKEN_URI=https://oauth2.googleapis.com/token
